{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Muxboard",
  "Version": "0.2.0.0",
  "Author": "mrshu",
  "UUID": "com.mrshu.muxboard",
  "Icon": "imgs/plugin/icon",
  "Description": "Stream Deck+ dashboard for cmux, Orca, and Herdr coding agents, with live attention keys and CodexBar quotas, pace, spend, tokens, and credits on the LCD.",
  "Category": "Muxboard",
  "CategoryIcon": "imgs/plugin/category",
  "CodePath": "bin/plugin.cjs",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.5"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    }
  ],
  "Nodejs": {
    "Version": "20",
    "Debug": "enabled"
  },
  "Actions": [
    {
      "Name": "Attention Slot",
      "UUID": "com.mrshu.muxboard.attention",
      "Icon": "imgs/actions/attention/icon",
      "Tooltip": "Shows cmux, Orca, and Herdr agents. Press to focus the existing pane or session; hold to snooze locally.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/attention/key",
          "TitleAlignment": "middle",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Muxboard Dial",
      "UUID": "com.mrshu.muxboard.dial",
      "Icon": "imgs/actions/dial/icon",
      "Tooltip": "CodexBar quota segment + Muxboard dial controls.",
      "Controllers": [
        "Encoder"
      ],
      "States": [
        {
          "Image": "imgs/actions/dial/key"
        }
      ],
      "Encoder": {
        "Icon": "imgs/actions/dial/icon",
        "layout": "layouts/segment.json",
        "background": "imgs/actions/dial/segment",
        "TriggerDescription": {
          "Rotate": "Adjust",
          "Push": "Activate",
          "Touch": "Activate"
        }
      }
    }
  ]
}
